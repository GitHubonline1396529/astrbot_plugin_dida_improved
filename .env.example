# Path to AstrBot core source directory (required for running tests)
# This should point to the directory containing the astrbot/ package.
ASTRBOT_CORE_PATH=/path/to/AstrBot/core

# Dida365 Open API Access Token (required for integration tests)
# See docs/configuration.md for how to obtain a token.
DIDA_ACCESS_TOKEN=your_token_here
DIDA_BASE_URL=https://api.dida365.com/open/v1
